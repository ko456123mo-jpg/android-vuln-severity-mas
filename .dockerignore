# =====================================================================
# .dockerignore — لا تنتقل البيانات والبيئات والأسرار إلى الصور
# =====================================================================

# ── بيانات التشغيل (تُربط كـ volumes لا تُنسخ) ──────────────────────
data/
results/

# ── الأسرار ────────────────────────────────────────────────────────
.env
.env.*
!.env.example
*.key
*.pem
*.crt

# ── قواعد/ملفات قاعدة البيانات ─────────────────────────────────────
*.db
*.db-wal
*.db-shm
*.sqlite

# ── بيئات وأدوات تطوير ─────────────────────────────────────────────
.venv/
venv/
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
.mypy_cache/
.ipynb_checkpoints/
.coverage
htmlcov/

# ── إصدارات ────────────────────────────────────────────────────────
.git/
.gitignore
.github/
node_modules/

# ── ملفات مضغوطة/مؤقتة ─────────────────────────────────────────────
*.log
*.tmp
*.zip
*.tar.gz
