# =====================================================================
# متغيرات البيئة — انسخ هذا الملف إلى .env ثم املأ القيم
# Environment variables — copy this file to .env and fill in the values
# =====================================================================
#   cp .env.example .env
#   ⚠️  لا ترفع .env إلى Git مطلقاً (مستثنى في .gitignore) — لا أسرار في المستودع.
#   كل القيم اختيارية في وضع Mock: النظام يعمل بلا أي مفتاح عند ضبط
#   LLM_MOCK_MODE=1 MCP_MOCK_MODE=1 EMBEDDING_MOCK_MODE=1 (مناسب للتجربة والعرض).
# =====================================================================

# ── 1) البيئة العامة / General ──────────────────────────────────────
# development | production · الإنتاج يفعّل: HSTS + رفض الأسرار الضعيفة عند الإقلاع
MAS_ENV=production

# ── 2) الأمان / Security (إلزامي في الإنتاج) ─────────────────────────
# مفتاح توقيع JWT — ≥ 32 حرفاً. ولّده بـ:
#   python -c "import secrets;print(secrets.token_urlsafe(48))"
# النظام يرفض الإقلاع (RuntimeError) إن كان غائباً أو ضعيفاً في الإنتاج.
MAS_SECRET_KEY=

# كلمة مرور حساب admin الأولي (استُخدمت في البذر). الافتراضي admin123 للتطوير فقط.
MAS_ADMIN_PASSWORD=

# منافذ CORS المسموح بها (قائمة بفواصل). اتركه فارغاً للتطوير فقط (CORS مفتوح).
# مثال إنتاجي: https://console.example.org,https://reports.example.org
MAS_CORS_ORIGINS=

# حدّ الطلبات لكل IP في الدقيقة (0/إسقاط = بلا حدّ). الافتراضي 60.
MAS_RATE_LIMIT_PER_MINUTE=60
# تعطيل حدّ المعدل كاملاً: 0 أو false (للتطوير/القياس فقط)
MAS_RATE_LIMIT_ENABLED=1
# إرسال HSTS حتى بلا MAS_ENV=production (يُفعّل تلقائياً عبر HTTPS أيضاً)
MAS_HSTS=0
# جودة سجل التطبيق: DEBUG|INFO|WARNING|ERROR
MAS_LOG_LEVEL=INFO

# ── 3) مزوّدو النماذج / LLM providers (واحد يكفي) ────────────────────
# الترتيب المحاولات: anthropic → groq → gemini → ollama (حسب المفاتيح المتاحة)
ANTHROPIC_API_KEY=
GROQ_API_KEY=            # يجب أن تبدأ بـ gsk_ (يتحقق منها النظام عند الإقلاع)
GOOGLE_API_KEY=          # Gemini — تبدأ بـ AIza (تحذير إن اختلفت)

# ── 4) Ollama (نماذج محلية / local models) ──────────────────────────
# داخل Docker استخدم http://ollama:11434 (لا localhost — الخدمات حاويات منفصلة)
OLLAMA_BASE_URL=http://localhost:11434
# تشغيل خدمة ollama الاختيارية: docker compose --profile ollama up -d
MAS_OLLAMA_MODEL=llama3.2:3b

# ── 5) MobSF (تحليل ساكن/ديناميكي) ──────────────────────────────────
# داخل Docker استخدم http://mobsf:8000 (الشبكة الداخلية؛ الخدمة غير منشورة)
MOBSF_URL=http://localhost:8000
MOBSF_API_KEY=           # يُولَّد من واجهة MobSF: /api_docs ثم REST API Key

# ── 6) قاعدة البيانات والمخزن المتجهي / Database & vectors ──────────
# SQLite: مسار ملف واحد يُنسخ احتياطياً بسهولة (WAL مفعّل تلقائياً)
DATABASE_PATH=./data/app.db
# خلفية التضمين: auto | sentence-transformers | api | tfidf
#   auto: يحاول sentence-transformers ثم API ثم TF-IDF (يعمل بلا إنترنت بلا تغيير)
MAS_EMBEDDING_BACKEND=auto
# ظبط يدوي لخلفية التضمين: 1 = متجهات حتمية بلا نموذج (اختبار/عرض)
EMBEDDING_MOCK_MODE=0

# ── 7) أوضاع Mock (بلا شبكة / بلا أدوات حقيقية) ──────────────────────
# مفيدة للعرض الأكاديمي والاختبارات: نفس السلوك بلا مفاتيح وبلا إنترنت
LLM_MOCK_MODE=0          # 1 = نماذج لغوية مزيفة حتمية
MCP_MOCK_MODE=0          # 1 = أدوات الفحص مزيفة (JADX/MobSF/Frida/Objection)

# ── 8) الوكلاء والفحص / Agents & scanning ───────────────────────────
MAS_MAX_VULNERABILITIES_PER_SCAN=200   # سقف صريح يمنع انفجار الحالة على APK كبير
MAS_SCAN_TIMEOUT_SECONDS=900           # مهلة الفحص الكاملة (ثوانٍ)
MAS_CONTEXT_CHAR_LIMIT=6000            # سقف نص كتلة المعرفة المُمرَّرة للمستخرج

# ── 9) الواجهة / UI ────────────────────────────────────────────────
MAS_API_URL=http://localhost:8000      # داخل Docker: http://api:8000
MAS_UI_PORT=8501
MAS_API_PORT=8000

# ── 10) المنافذ لأدوات التشغيل / Ports used by make/compose ─────────
# (تُقرأ في docker-compose.yml — لا تحتاج تغييراً إلا عند التعارض)
MAS_MOBSF_INTERNAL_PORT=8000
