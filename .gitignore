# =====================================================================
# .gitignore — لا بيانات تشغيلية ولا أسرار ولا مخرجات مولَّدة في Git
# =====================================================================

# ── بيانات تشغيلية / Runtime data (قاعدة + APK + تقارير) ────────────
data/*
!data/.gitkeep
!data/**/.gitkeep
*.db
*.db-wal
*.db-shm
*.sqlite
*.sqlite3

# ── مخرجات القياس والتجربة / Generated results ──────────────────────
results/*
!results/.gitkeep
!results/README.md

# ── حزم الإصدار/التوزيع / Release artifacts ─────────────────────────
release/
*.tar.gz
*.tgz
*.zip
*.bundle

# ── أسرار / Secrets (لا تُرفع أبداً) ────────────────────────────────
.env
.env.*
!.env.example
.streamlit/secrets.toml
*.key
*.pem
*.p12
*.pfx
*.crt
credentials.json
service-account*.json

# ── بايثون / Python ────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.pyo
*.egg-info/
*.egg
.eggs/
build/
dist/
.venv/
venv/
env/
.python-version

# ── أدوات وجودة / Tooling caches ───────────────────────────────────
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
.coverage.*
htmlcov/
coverage.xml
.tox/
.nox/

# ── محرّرات وأنظمة / Editors & OS ──────────────────────────────────
.ipynb_checkpoints/
.idea/
.vscode/
*.swp
*~
.DS_Store
Thumbs.db
desktop.ini

# ── Node (إن استُخدمت أدوات واجهة) ─────────────────────────────────
node_modules/
package-lock.json
yarn.lock
.pnpm-store/

# ── سجلات ومؤقتات / Logs & temp ────────────────────────────────────
*.log
logs/
tmp/
temp/
*.tmp
*.bak

# ── ملاحظات: استثناءات صريحة نريد تتبّعها ──────────────────────────
# (نتائج مرجعية مُصرَّح بها فقط تُضاف بـ git add -f بعد مراجعة يدوية)
!results/*.md.sample
